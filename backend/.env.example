# --- Base de données PostgreSQL (Ville) ---
# En dev local : valeurs du service `db` du docker-compose.yml.
# En prod : demander l'hôte/utilisateur/mot de passe à l'équipe DSI.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ivry_admin
POSTGRES_USER=mandat_dev
POSTGRES_PASSWORD=mandat_dev
POSTGRES_SCHEMA=mandat   # nom du schéma dédié à l'appli (jamais en dur dans le code, cf. guide §1.1/§2)

# --- API centrale APM (services transverses : mail, SMS, AD...) ---
APM_API_URL=https://api.ivry.local
APM_API_KEY=            # clé X-API-KEY fournie par l'admin APM (permissions: ad_auth, ad_search, ad_read, mail_send, sms_send)
# Mettre à "false" uniquement si APM_API_URL pointe vers l'hôte interne Ville
# avec un certificat auto-signé connu (PKI interne). Ne jamais désactiver
# pour un hôte public/externe. Par défaut : vérification TLS active.
APM_TLS_REJECT_UNAUTHORIZED=true

# --- API métier Hub DSI (référentiels Ville : directions, élus, sites...) ---
HUBDSI_API_URL=http://10.103.130.106:3001   # provisoire, cible https://dsihub.ivry.local
HUBDSI_API_KEY=          # clé dsk_... fournie par l'admin Hub DSI (scope: ville)

# --- Application ---
PORT=5151
JWT_SECRET=change-me-in-prod
NODE_ENV=development

# --- Accès de secours admin ---
# Identifiants créés par scripts/seed-admin.js si aucun admin n'existe déjà.
# À changer immédiatement après la première connexion (voir README).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-immediately

# --- CORS ---
# Doit être l'origine EXACTE (protocole + hôte + port) depuis laquelle le
# navigateur charge le frontend. En dev local, le proxy Vite rend le problème
# invisible (tout passe par la même origine) ; en Docker/prod, front et back
# sont sur des ports différents pour le navigateur — sans la bonne valeur ici,
# TOUTES les requêtes API échouent silencieusement (bloquées par le
# navigateur), ce qui ressemble à "le front n'a pas accès au back".
# Exemple déploiement distant : CORS_ORIGIN=http://10.103.130.106:5150
CORS_ORIGIN=http://localhost:5150

# --- Stockage des fichiers uploadés ---
# Par défaut : <repo>/data/{uploads,attachments}. En Docker, pointer vers le
# volume monté (cf. docker-compose.yml) pour survivre aux rebuilds.
# UPLOADS_DIR=/app/data/uploads
# ATTACHMENTS_DIR=/app/data/attachments
